# Backend Configuration
# ========================

# Environment mode: development or production
APP_ENV=development

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Internal secret for authenticating internal-only endpoints (e.g., /internal/refresh-cache)
# Required in production.
INTERNAL_SECRET=

# Optional error tracking
SENTRY_DSN=

# OpenF1 API Authentication (optional - enables premium live data features)
OPENF1_ACCESS_TOKEN=
OPENF1_USERNAME=
OPENF1_PASSWORD=

# GitHub Token (optional - for TracingInsights proxy)
GITHUB_TOKEN=

# Redis URL (optional - for distributed caching across multiple workers)
REDIS_URL=

# Frontend Configuration
# ========================

# Backend API URL (for frontend to communicate with backend)
VITE_API_BASE_URL=http://localhost:8000/api

# WebSocket URL for live session streaming
VITE_WS_URL=ws://localhost:8000/ws/live
